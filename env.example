# ==============================================================================
# Hybrid Database Backup Configuration (.env.example)
# Copy to .env and restrict permissions: chmod 600 .env
# ==============================================================================

# 1. Database Connection Settings ("postgres" or "mysql")
DB_ENGINE="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="enterprise_core_db"
DB_USER="backup_operator"
DB_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# 2. Local Staging & Retention
LOCAL_BACKUP_DIR="/var/backups/hybrid-db"
LOCAL_RETENTION_DAYS=7

# 3. Hybrid Storage & Tailscale Mesh Verification
# Leave TAILSCALE_MINIO_IP empty if syncing directly to public S3
TAILSCALE_MINIO_IP="100.64.0.15"
RCLONE_REMOTE_NAME="minio-onprem"
RCLONE_BUCKET_NAME="production-db-backups"
REMOTE_RETENTION_DAYS=30

# 4. Optional GPG Encryption At-Rest ("true" or "false")
ENABLE_GPG_ENCRYPTION="false"
GPG_PASSPHRASE="CHANGE_ME_ENCRYPTION_PASSPHRASE"

# 5. Observability Webhook (Slack / Discord / Telegram Gateways)
WEBHOOK_URL=""
